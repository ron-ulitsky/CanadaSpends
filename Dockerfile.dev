# Development Dockerfile for CanadaSpends
# This Dockerfile is optimized for local development with hot reload

FROM node:20-alpine

# Install pnpm globally (matches packageManager in package.json)
RUN corepack enable && corepack prepare pnpm@9.5.0 --activate

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml ./

# Install dependencies
# Note: Using regular install (not --frozen-lockfile) in dev to allow
# package.json changes without manually updating lockfile
RUN pnpm install

# Copy configuration files needed for the build
COPY tsconfig.json ./
COPY postcss.config.mjs ./
COPY tailwind.config.ts ./
COPY next.config.ts ./
COPY lingui.config.js ./
COPY mdx-components.tsx ./
COPY components.json ./

# Copy source directories
# Note: In development, these are mounted as volumes for hot reload
# but we copy them here for the initial build
COPY src ./src
COPY public ./public
COPY data ./data
COPY articles ./articles

# Expose the development server port
EXPOSE 3000

# Set environment variables for development
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Start the development server with Turbopack
CMD ["pnpm", "dev"]